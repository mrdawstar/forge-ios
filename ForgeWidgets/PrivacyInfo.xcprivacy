<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- The widgets collect nothing. They make no request of any kind: the
	     snapshot they draw is written by the app into the shared App Group and
	     read back here, and it holds names and done flags and nothing else. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Reading that snapshot is the App Group `UserDefaults`, which is
	     information stored by this app and read back by this app: CA92.1.
	     Declared separately because an extension ships as its own binary and
	     the app's manifest does not cover it. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
