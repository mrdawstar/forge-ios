<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Forge tracks nobody. There is no advertising identifier, nothing is
	     joined to data from another company, and the one third-party framework
	     (TelemetryDeck, anonymous usage) is not a tracking domain. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- **Anonymous usage, and nothing else.** (FORGE_CONTEXT.md §2p)

	     With "Share anonymous usage" on — the default — Forge sends TelemetryDeck
	     a short list of events (`ForgeTelemetry.Event`): which first-run beat
	     was seen, that an activity was completed and how, that a day was earned,
	     that a challenge was taken. That is Product Interaction. Each signal
	     also carries what the SDK attaches itself — device model, OS and app
	     version, screen size, language, locale, region, time zone, appearance and
	     accessibility settings, and its own session counts: Other Diagnostic Data.

	     Neither is linked: there is no account, and TelemetryDeck receives only a
	     double-hashed, anonymised installation identifier it
	     cannot reverse. Neither is
	     used for tracking. No activity name, identity, chapter, review, quote
	     or health reading is ever included — `Event` has no case that could
	     carry one. Still no visible account (§2n). -->
	<!-- **Apple Health is read, on the device, and not collected.**
	     (FORGE_CONTEXT.md §17.5, APP_STORE.md §1)

	     Forge reads steps, workout minutes, sleep and mindful minutes through
	     HealthKit, read-only (`HealthBridge`, an empty share set), to tick off
	     the activities they measure. A reading is used on the phone and
	     dropped: never stored, never synced, never sent to telemetry or an AI
	     brief (Ask Forge sends whether today's activities are done, never a
	     reading). Nothing leaves the device, so Health & Fitness is not a
	     collected data type and is deliberately absent from the list below. -->
	<!-- **Forge's AI, since 1.1 (FORGE_CONTEXT.md §17.6, APP_STORE.md §1).**

	     Only for Forge Pro, only after the person presses Allow on the in-app
	     disclosure (revocable in Settings -> Planning), and only when they press
	     something that asks: Plan's "Work it out", the review's "Read my week",
	     or a message in Ask Forge. The request goes to Forge's own Supabase
	     edge function, which asks OpenAI to answer (`store: false`).

	     - Other User Content: the `AIBrief` (activity names, times, lengths and
	       days; identity statements and the chapter's intention; counts), for
	       a reading one week's counts, Plan's typed request, and for Ask Forge
	       the six scores and OVR, the running Arc's id/day/phase, today's list
	       with what is done, and the last eight messages. Never stored by
	       Forge's server; never a health reading, a date, a review's words.
	     - Purchase History: the Apple-signed StoreKit transaction, verified by
	       the server; its originalTransactionId keys the daily quota.
	     - User ID: the invisible anonymous Supabase user, minted on the first
	       request, used to authenticate and rate-limit.

	     Declared LINKED, the conservative reading: every request travels under
	     the anonymous user id, which identifies an account even though the
	     account has no name, email or password. None of it is used for
	     tracking. If this is ever changed to not linked, APP_STORE.md §1 must
	     change with it. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Purchase History has two purposes since 1.1's release pass
		     (FORGE_CONTEXT.md §17.7): App Functionality, the StoreKit proof the
		     AI request carries; and Analytics, because the anonymous usage
		     events include the paywall's — trial_started and
		     purchase_completed with the plan, paywall_view with its door —
		     which are purchase tendencies in Apple's sense. A label is one row
		     per type, so it stays LINKED: the AI's conservative reading
		     governs, and the telemetry half is over-stated rather than
		     under-stated. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>

	<!-- The only required-reason API in either target. Everything Forge keeps
	     is `UserDefaults` plus `Codable`, in an App Group shared with its own
	     widgets — which is exactly what CA92.1 covers: information stored by
	     this app, read back by this app. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
